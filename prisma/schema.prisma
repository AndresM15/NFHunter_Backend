generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model Event {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(120)
  description String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  nfcTags     NfcTag[]

  @@map("events")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  nickname     String         @unique @db.VarChar(50)
  email        String         @unique @db.VarChar(150)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  avatarUrl    String?        @map("avatar_url")
  levelTitle   String?        @default("Explorador Urbano") @map("level_title") @db.VarChar(50)
  totalPoints  Int            @default(0) @map("total_points")
  role         Role           @default(USER)
  createdAt    DateTime       @default(now()) @map("created_at")
  scans        ScansHistory[]

  @@map("users")
}

model NfcTag {
  id           String         @id @default(uuid()) @db.Uuid
  code         String         @unique @db.VarChar(100)
  name         String         @db.VarChar(100)
  description  String?
  pointsReward Int            @default(10) @map("points_reward")
  location     Unsupported("geography(Point, 4326)")
  isHidden     Boolean        @default(false) @map("is_hidden")
  clueText     String?        @map("clue_text")
  cardTitle    String?        @map("card_title") @db.VarChar(100)
  cardImageUrl String?        @map("card_image_url")
  cardFunFact  String?        @map("card_fun_fact")
  eventId      Int?           @map("event_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  
  event        Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  scans        ScansHistory[]

  @@map("nfc_tags")
}

model ScansHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  tagId        String   @map("tag_id") @db.Uuid
  userLocation Unsupported("geography(Point, 4326)") @map("user_location")
  pointsEarned Int      @map("points_earned")
  scannedAt    DateTime @default(now()) @map("scanned_at")

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  NfcTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@map("scans_history")
}